@implements IDialogContentComponent<DataAccess.DTOs.ExerciseDto>

@inject Business.Services.ITagService tagService
@inject DataAccess.Repositories.IDayRepository dayService

@using Business.Extensions

<FluentDialogBody>
    <div class="w-100">
        <FluentLabel Typo="Typography.H6"
                     Class="w-100">
            Descrizione
        </FluentLabel>
        <div class="px-2">
            <FluentTextField Class="w-100"
                             @bind-Value="@Content.Description" />
        </div>
    </div>
    <div class="w-100 pt-2">
        <FluentLabel Typo="Typography.H6"
                     Class="w-100">
            Pausa
        </FluentLabel>
        <div class="px-2">
            <FluentNumberField Class="w-100"
                               @bind-Value="@Content.Rest" />
        </div>
    </div>
    @if (allTags.Count > 0)
    {
        <div class="w-100 pt-2">
            <FluentLabel Typo="Typography.H6"
                         Class="w-">
                Tags
            </FluentLabel>
            <div class="px-2">
                <FluentAutocomplete Class="w-100"
                                    Id="tag-listbox"
                                    Placeholder="Scegli..."
                                    MaxAutoHeight="true"
                                    OnOptionsSearch=@OnSearch
                                    TOption="DataAccess.DTOs.TagDto"
                                    Items=@tags
                                    Multiple="true"
                                    OptionText=@(xx => xx.Name)
                                    @bind-SelectedOptions=@Content.Tags />
            </div>
        </div>
    }
    <div class="w-100 pt-2">
        <FluentLabel Typo="Typography.H6"
                     Class="w-100">
            Note
        </FluentLabel>
        <div class="px-2">
            <FluentTextArea Class="w-100"
                            Rows="10"
                            @bind-Value=@Content.Notes />
        </div>
    </div>
    <div class="w-100 pt-2">
        <FluentLabel Typo="Typography.H6"
                     Class="pb-2">
            Allenamenti
        </FluentLabel>
        <div class="w-100 px-2 d-flex flex-wrap">
            @foreach (var item in days)
            {
                <div role="button"
                     class="pe-2"
                     onclick=@(() => ToggleSelected(item))>
                    <FluentPresenceBadge Status=@(item.Selected? PresenceStatus.Available: PresenceStatus.Offline)>
                        <FluentCard Class="py-2">
                            <FluentLabel Typo="Typography.Body"
                                         Class="w-100">
                                @item.Text
                            </FluentLabel>
                        </FluentCard>
                    </FluentPresenceBadge>
                </div>
            }
        </div>
    </div>
</FluentDialogBody>

@code {
    [Parameter]
    public required DataAccess.DTOs.ExerciseDto Content { get; set; }

    private List<DataAccess.DTOs.TagDto> tags = [];
    private List<DataAccess.DTOs.TagDto> allTags = [];
    private List<string> selectedTags = [];
    private List<Option<DataAccess.DTOs.DayDto>> days = [];

    protected override async Task OnInitializedAsync()
    {
        allTags = (await tagService.Get())
            .OrderBy(xx => xx.Name)
            .ToList();
        tags = (await tagService.Get())
            .OrderBy(xx => xx.Name)
            .ToList();
        days = (await dayService.Get())
            .OrderBy(xx => xx.Priority)
            .Select(day => new Option<DataAccess.DTOs.DayDto>()
            {
                Text = day.Description,
                Value = day,
                Selected = day.Exercises.Contains(Content.Id),
            })
            .ToList();
    }

    private void OnSearch(OptionsSearchEventArgs<DataAccess.DTOs.TagDto> e)
    {
        tags = allTags
            .Where(i => i.Name.StartsWith(e.Text, StringComparison.OrdinalIgnoreCase))
            .OrderBy(i => i.Name)
            .ToList();
    }

    private async Task ToggleSelected(Option<DataAccess.DTOs.DayDto> day)
    {
        if (day.Selected)
        {
            day.Value!.Exercises.Remove(Content.Id);
            day.Selected = false;
        }
        else
        {
            day.Value!.Exercises.Add(Content.Id);
            day.Selected = true;
        }
        await dayService.Upsert(day.Value!);

        StateHasChanged();
    }
}
