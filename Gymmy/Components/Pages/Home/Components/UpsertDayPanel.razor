@implements IDialogContentComponent<DataAccess.DTOs.DayDto>

<FluentDialogBody>
    <FluentLabel Typo="Typography.H6"
                 Class="w-100">
        Descrizione
    </FluentLabel>
    <div class="px-2">
        <FluentTextField class="w-100"
                         @bind-Value="@Content.Description" />
    </div>
    <FluentLabel Typo="Typography.H6"
                 Class="w-100">
        Note
    </FluentLabel>
    <div class="px-2">
        <FluentTextArea Class="w-100"
                        Rows="10"
                        @bind-Value=@Content.Notes />
    </div>
</FluentDialogBody>

@code {
    [Parameter]
    public required DataAccess.DTOs.DayDto Content { get; set; }
}
